#!/usr/bin/env bash
# Sample pre-push hook: refuse the push unless the combat gate is green.
# Install:  ln -s ../../tools/hooks/pre-push .git/hooks/pre-push
# Skip once: git push --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
tools/run_checks.sh || { echo "pre-push: tools/run_checks.sh failed — push refused (--no-verify to override)"; exit 1; }
